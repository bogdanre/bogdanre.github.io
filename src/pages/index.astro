---
//import Navbar from '../components/Navbar.astro';
import "../styles/global.css";
import BaseLayout from '../layouts/BaseLayout.astro';
//import { BRAND } from 'astro:schema';
---


<BaseLayout>
  <section class="">
    <!-- Center this div -->
    <div class="">
      <div class="bg-base-400 rounded-lg p-4 mb-8">
        <h5 class=" lg:text-6xl text-8xl font-semibold bg-linear-to-bl to-secondary inline-block from-primary bg-clip-text text-transparent py-4">
         Hi, I'm Bogdan
        </h5>

        <div class="text-base-content">

          <p>
          I'm a computer science student focusing on IT security, web technologies and Linux.
        </p>

        <br/>
        <p>
          I currently work as a student assistant at the Chair of Empirical Software Engineering at Paderborn University, where I support research on security usability and ethics.
        </p>
        <br/>
        <p>
          This website is very much WIP right now and more content will follow soon.
        </p>
        </div>
        <br/>
        
      <div class="btn btn-primary btn-outline btn-lg">
        <a
          href="/short_cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class=""
        >
        Download my CV (German)
        </a>
      </div>
  </section>

</BaseLayout>