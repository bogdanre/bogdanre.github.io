---
//import Navbar from '../components/Navbar.astro';
import "../styles/global.css";
import BaseLayout from '../layouts/BaseLayout.astro';
//import { BRAND } from 'astro:schema';
---


<BaseLayout>
  <section class="">
    <!-- Center this div -->
    <div class="">
      <div class="bg-ctp-surface0 rounded-lg shadow-md p-4 mb-8">
        <h5 class=" text-4xl font-semibold bg-linear-to-bl from-ctp-blue inline-block to-green-400 bg-clip-text text-transparent z-1 py-2">
         Hi, I'm Bogdan
        </h5>

        <div class="text-2xl">

          <p>
          I like Web Development and creating user friendly software.
        </p>

        <br/>
        <p>
          Currently I am a student of computer science at the University of Paderborn.
          I am a student assistant at the chair of empirical software engineering where I help with research on ethics and usability.
        </p>
        <br/>
        <p>
          This website is very much WIP right now and more content will follow soon.
        </p>
        </div>
        <br/>
        
      <div class="text-2xl">
        <a
          href="/cv"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ctp-blue underline hover:text-blue-800"
        >
        Download my CV (German)
        </a>
      </div>
  </section>

</BaseLayout>